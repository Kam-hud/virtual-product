# VirtualStore 环境变量示例（复制为 .env 使用；.env 已被 gitignore，勿提交）
# 本地开发：可使用 Supabase 连接串，或独立 PostgreSQL 字段

# 方式一：PostgreSQL 连接串（推荐，Supabase 项目页面提供）
# DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# 方式二：独立字段（本地 PostgreSQL）
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=virtual_store

# 服务器配置
SERVER_PORT=3001

# JWT 配置（生产环境务必改为随机长字符串）
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d

# CORS 允许来源（逗号分隔；部署后加入前端域名）
# CORS_ORIGIN=http://localhost:5173,https://kam-hud.github.io

# ---------- 前端环境变量（Vite 构建时注入，前缀必须为 VITE_） ----------
# 后端 API 地址：本地留空走 /api 代理；部署后指向 Vercel 后端域名
# VITE_API_BASE=https://virtual-store.vercel.app
# GitHub Pages 子路径部署时设置（仓库名为 virtual-product）：
# VITE_BASE_PATH=/virtual-product/
